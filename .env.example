# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/identity_db
DB_USERNAME=identity_user
DB_PASSWORD=identity_pass

# Server Configuration
SERVER_PORT=8080

# JWT RSA Key Paths
JWT_PRIVATE_KEY_PATH=classpath:certs/private_key.pem
JWT_PUBLIC_KEY_PATH=classpath:certs/public_key.pem

# SMTP Mail Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_APP_PASSWORD=your-smtp-app-password

