# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/identity_db
DB_USERNAME=identity_user
DB_PASSWORD=identity_pass

# Server Configuration
SERVER_PORT=8080

# JWT RSA Key Paths (RS256 Asymmetric Signing)
# NEVER commit private keys or real key files to git!
# Generate a local 2048-bit RSA keypair for development using:
#   .\mvnw.cmd compile exec:java -Dexec.mainClass="lk.ac.kelaniya.ams.identity_access_service.security.RsaKeyPairGenerator"
# This creates certs/private_key.pem and certs/public_key.pem in the gitignored 'certs/' directory.
# In production, key paths must reference external secret store mounts (e.g. file:/secrets/private_key.pem).
JWT_PRIVATE_KEY_PATH=file:certs/private_key.pem
JWT_PUBLIC_KEY_PATH=file:certs/public_key.pem

# API Gateway Public Key (used ONLY to verify incoming Bearer tokens forwarded by Gateway)
# In production, this references the API Gateway's public key certificate
GATEWAY_JWT_PUBLIC_KEY=file:certs/gateway_public_key.pem

# Service RSA Private Key (used ONLY to sign outbound Service JWTs from generateServiceToken)
# In production, this references the service private key certificate
SERVICE_JWT_PRIVATE_KEY=file:certs/service_private_key.pem

# SMTP Mail Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_APP_PASSWORD=your-smtp-app-password

